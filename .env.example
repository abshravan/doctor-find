# ---- Core ----
APP_ENV=local
APP_NAME=DoctorFind
SECRET_KEY=change-me-in-prod-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# ---- Database ----
POSTGRES_USER=doctorfind
POSTGRES_PASSWORD=doctorfind
POSTGRES_DB=doctorfind
DATABASE_URL=postgresql+asyncpg://doctorfind:doctorfind@db:5432/doctorfind

# ---- Redis ----
REDIS_URL=redis://redis:6379/0

# ---- LLM ----
LLM_PROVIDER=gemini            # gemini | openai | anthropic
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ---- Voice ----
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=centralindia
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ---- Telephony / Messaging (India) ----
EXOTEL_SID=
EXOTEL_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
WHATSAPP_PROVIDER=gupshup       # gupshup | meta
GUPSHUP_API_KEY=
MSG91_AUTH_KEY=

# ---- Feature flags ----
ENABLE_AI_TRIAGE=true
ENABLE_VOICE=false
